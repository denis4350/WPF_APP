<Window x:Class="ProjectManager.Windows.ProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="Новый проект"
        Width="520"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6F8">

    <Border Margin="20"
            CornerRadius="15"
            Background="White"
            Padding="30">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <TextBlock Grid.Row="0"
                       Text="Новый проект"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,0,0,25"/>


            <TextBlock Grid.Row="1"
                       Text="Название проекта"
                       FontWeight="SemiBold"
                       Margin="0,0,0,7"/>


            <TextBox Grid.Row="2"
                     x:Name="ProjectNameTextBox"
                     Height="40"
                     Padding="10"
                     Margin="0,0,0,20"/>


            <TextBlock Grid.Row="3"
                       Text="Описание"
                       FontWeight="SemiBold"
                       Margin="0,0,0,7"/>


            <TextBox Grid.Row="4"
                     x:Name="ProjectDescriptionTextBox"
                     Height="120"
                     Padding="10"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True"/>


            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,25,0,0">

                <Button Content="Отмена"
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>

                <Button Content="Создать"
                        Width="120"
                        Height="40"
                        Click="Create_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>