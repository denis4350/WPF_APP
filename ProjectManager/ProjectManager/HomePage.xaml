<Page x:Class="ProjectManager.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="30">

            <TextBlock Text="Добро пожаловать!"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#20242B"/>

            <TextBlock Text="Здесь отображается общая информация по вашим проектам."
                       FontSize="14"
                       Foreground="#7B8491"
                       Margin="0,7,0,25"/>

            <!-- КАРТОЧКИ -->
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="12"
                        Margin="0,0,10,0"
                        Padding="20">

                    <StackPanel>
                        <TextBlock Text="ПРОЕКТЫ"
                                   FontSize="12"
                                   Foreground="#7B8491"/>

                        <TextBlock x:Name="ProjectsCountText"
                                   Text="0"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="Всего проектов"
                                   Foreground="#7B8491"/>
                    </StackPanel>

                </Border>

                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="12"
                        Margin="10,0"
                        Padding="20">

                    <StackPanel>
                        <TextBlock Text="ЗАДАЧИ"
                                   FontSize="12"
                                   Foreground="#7B8491"/>

                        <TextBlock x:Name="TasksCountText"
                                   Text="0"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="Всего задач"
                                   Foreground="#7B8491"/>
                    </StackPanel>

                </Border>

                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="12"
                        Margin="10,0,0,0"
                        Padding="20">

                    <StackPanel>
                        <TextBlock Text="ЗАВЕРШЕНО"
                                   FontSize="12"
                                   Foreground="#7B8491"/>

                        <TextBlock x:Name="CompletedCountText"
                                   Text="0"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="Завершённых проектов"
                                   Foreground="#7B8491"/>
                    </StackPanel>

                </Border>

            </Grid>

            <!-- ПОСЛЕДНИЕ ПРОЕКТЫ -->
            <TextBlock Text="Последние проекты"
                       FontSize="21"
                       FontWeight="Bold"
                       Margin="0,30,0,15"/>

            <ItemsControl x:Name="ProjectsList">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border Background="White"
                                CornerRadius="10"
                                Padding="18"
                                Margin="0,0,0,10">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>

                                    <TextBlock Text="{Binding Name}"
                                               FontSize="17"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="{Binding Description}"
                                               Foreground="#7B8491"
                                               Margin="0,5,0,0"/>

                                </StackPanel>

                                <StackPanel Grid.Column="1">

                                    <TextBlock Text="{Binding Progress, StringFormat={}{0}%}"
                                               HorizontalAlignment="Right"
                                               FontWeight="Bold"/>

                                    <ProgressBar Value="{Binding Progress}"
                                                 Height="8"
                                                 Margin="0,8,0,0"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </StackPanel>

    </ScrollViewer>

</Page>