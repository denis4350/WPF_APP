<Window x:Class="ProjectManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="Project Manager"
        Width="1250"
        Height="750"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

    <Window.Resources>

        <SolidColorBrush x:Key="PageBackground"
                         Color="#F4F6F8"/>

        <SolidColorBrush x:Key="CardBackground"
                         Color="White"/>

        <SolidColorBrush x:Key="MainText"
                         Color="#20242B"/>

        <SolidColorBrush x:Key="SecondaryText"
                         Color="#7B8491"/>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ -->
        <Border Grid.Column="0"
                Background="#20242B">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="100"/>
                </Grid.RowDefinitions>

                <!-- ЛОГОТИП -->
                <StackPanel Grid.Row="0"
                            Margin="25,25,10,10">

                    <TextBlock Text="PROJECT"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="MANAGER"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#5B8DEF"/>
                </StackPanel>

                <!-- НАВИГАЦИЯ -->
                <StackPanel Grid.Row="1"
                            Margin="12,15,12,10">

                    <Button Tag="Home"
                            Click="Navigation_Click"
                            Height="50"
                            Margin="0,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            HorizontalContentAlignment="Left"
                            Padding="20,0">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂"
                                       FontSize="22"
                                       Width="35"/>

                            <TextBlock Text="Главная"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="Projects"
                            Click="Navigation_Click"
                            Height="50"
                            Margin="0,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            HorizontalContentAlignment="Left"
                            Padding="20,0">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▣"
                                       FontSize="20"
                                       Width="35"/>

                            <TextBlock Text="Проекты"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="Tasks"
                            Click="Navigation_Click"
                            Height="50"
                            Margin="0,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            HorizontalContentAlignment="Left"
                            Padding="20,0">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓"
                                       FontSize="20"
                                       Width="35"/>

                            <TextBlock Text="Задачи"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="Statistics"
                            Click="Navigation_Click"
                            Height="50"
                            Margin="0,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            HorizontalContentAlignment="Left"
                            Padding="20,0">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▥"
                                       FontSize="20"
                                       Width="35"/>

                            <TextBlock Text="Статистика"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="Settings"
                            Click="Navigation_Click"
                            Height="50"
                            Margin="0,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            HorizontalContentAlignment="Left"
                            Padding="20,0">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙"
                                       FontSize="20"
                                       Width="35"/>

                            <TextBlock Text="Настройки"
                                       FontSize="15"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- НИЖНЯЯ ЧАСТЬ -->
                <Border Grid.Row="2"
                        Margin="15"
                        Background="#2A2F38"
                        CornerRadius="10">

                    <StackPanel VerticalAlignment="Center"
                                Margin="15">

                        <TextBlock Text="Project Manager"
                                   Foreground="White"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Версия 1.0"
                                   Foreground="#9BA3AF"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ОСНОВНАЯ ОБЛАСТЬ -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="85"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource PageBackground}"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">

                <Grid Margin="30,0">

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock x:Name="PageTitle"
                                   Text="Главная"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MainText}"/>

                        <TextBlock x:Name="PageDescription"
                                   Text="Обзор текущего состояния проектов"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="145"
                            Height="42"
                            Click="AddProject_Click"
                            Background="#5B8DEF"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Content="+ Новый проект"/>

                </Grid>
            </Border>

            <!-- КОНТЕНТ -->
            <Frame x:Name="MainFrame"
                   Grid.Row="1"
                   NavigationUIVisibility="Hidden"
                   Background="#F4F6F8"/>

        </Grid>

    </Grid>

</Window>