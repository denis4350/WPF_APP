<Page x:Class="ProjectManager.StatisticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="30">

            <TextBlock Text="Статистика проектов"
                       FontSize="23"
                       FontWeight="Bold"/>

            <TextBlock Text="Общая информация по текущим проектам"
                       Foreground="#7B8491"
                       Margin="0,5,0,25"/>

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="12"
                        Margin="0,0,10,0"
                        Padding="25">

                    <StackPanel>

                        <TextBlock Text="Средний прогресс"
                                   FontSize="14"
                                   Foreground="#7B8491"/>

                        <TextBlock x:Name="AverageProgressText"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Margin="0,10"/>

                        <ProgressBar x:Name="AverageProgressBar"
                                     Height="10"/>

                    </StackPanel>

                </Border>

                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="12"
                        Margin="10,0,0,0"
                        Padding="25">

                    <StackPanel>

                        <TextBlock Text="Завершено проектов"
                                   FontSize="14"
                                   Foreground="#7B8491"/>

                        <TextBlock x:Name="CompletedText"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Margin="0,10"/>

                        <TextBlock Text="проектов завершено"
                                   Foreground="#7B8491"/>

                    </StackPanel>

                </Border>

            </Grid>

            <TextBlock Text="Прогресс проектов"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,30,0,15"/>

            <ItemsControl x:Name="StatisticsList">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border Background="White"
                                CornerRadius="10"
                                Padding="18"
                                Margin="0,0,0,10">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>

                                <ProgressBar Grid.Column="1"
                                             Value="{Binding Progress}"
                                             Height="10"
                                             VerticalAlignment="Center"
                                             Margin="15,0"/>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Progress, StringFormat={}{0}%}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </StackPanel>

    </ScrollViewer>

</Page>