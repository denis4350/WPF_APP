<Page x:Class="ProjectManager.ProjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource PageBackground}">

    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="30">

                <Button Content="+ Добавить проект"
                        Width="170"
                        Height="40"
                        HorizontalAlignment="Left"
                        Click="AddProject_Click"
                        Background="#5B8DEF"
                        Foreground="White"
                        BorderThickness="0"
                        Margin="0,0,0,20"/>

                <ItemsControl x:Name="ProjectsList">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border Background="White"
                                    CornerRadius="12"
                                    Padding="20"
                                    Margin="0,0,0,15">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="230"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="20"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="#7B8491"
                                                   Margin="0,7,0,7"/>

                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="#5B8DEF"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{Binding Progress, StringFormat={}{0}%}"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>

                                        <ProgressBar Value="{Binding Progress}"
                                                     Height="8"
                                                     Margin="10,8"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">

                                        <Button Content="Открыть"
                                                Tag="{Binding}"
                                                Click="Open_Click"
                                                Margin="4"
                                                Padding="12,7"/>

                                        <Button Content="Изменить"
                                                Tag="{Binding}"
                                                Click="Edit_Click"
                                                Margin="4"
                                                Padding="12,7"/>

                                        <Button Content="Удалить"
                                                Tag="{Binding}"
                                                Click="Delete_Click"
                                                Margin="4"
                                                Padding="12,7"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>